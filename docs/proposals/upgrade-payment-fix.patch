+// PROPOSED (not applied): apply a paid plan upgrade from the PayMongo webhook.
+// Mirrors backend/backend_utils/subscription_utils.upgrade_subscription():
+// previous_plan_id <- plan_id, plan_id <- new plan, status Active,
+// last_changed_at / updated_at <- now. end_date is NOT changed.
+
+export type UpgradePayment = {
+  payment_id: string;
+  payment_type: string | null;
+  hospital_id: string | null;
+  hospital_subscription_id: string | null;
+  plan_id: number | null;
+};
+
+export type SubscriptionRow = {
+  hospital_subscription_id: string;
+  hospital_id: string | null;
+  plan_id: number | null;
+  status: string | null;
+};
+
+export type UpgradeDecision =
+  | { apply: true; expectedPlanId: number | null; update: Record<string, unknown> }
+  | { apply: false; reason: string };
+
+export function planUpgrade(payment: UpgradePayment, subscription: SubscriptionRow | null, nowIso: string): UpgradeDecision {
+  if (payment.payment_type !== "upgrade") return { apply: false, reason: "not_upgrade" };
+  if (!payment.hospital_subscription_id || payment.plan_id == null) return { apply: false, reason: "missing_fields" };
+  if (!subscription) return { apply: false, reason: "subscription_not_found" };
+  if (subscription.hospital_subscription_id !== payment.hospital_subscription_id) return { apply: false, reason: "subscription_mismatch" };
+  if (payment.hospital_id && subscription.hospital_id !== payment.hospital_id) return { apply: false, reason: "hospital_mismatch" };
+  if (subscription.plan_id === payment.plan_id) return { apply: false, reason: "already_applied" };
+  if (subscription.status === "Cancelled") return { apply: false, reason: "subscription_cancelled" };
+
+  return {
+    apply: true,
+    expectedPlanId: subscription.plan_id,
+    update: {
+      previous_plan_id: subscription.plan_id,
+      plan_id: payment.plan_id,
+      status: "Active",
+      last_changed_at: nowIso,
+      updated_at: nowIso,
+    },
+  };
+}
