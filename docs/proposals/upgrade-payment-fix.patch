diff --git a/tests/email/upgrade_proposal.test.ts b/tests/email/upgrade_proposal.test.ts
new file mode 100644
index 0000000..4b041f1
--- /dev/null
+++ b/tests/email/upgrade_proposal.test.ts
@@ -0,0 +1,39 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { planUpgrade } from "../../supabase/functions/_shared/payments/upgrade.ts";
+
+const NOW = "2026-10-26T03:00:00.000Z";
+const payment = {
+  payment_id: "p1", payment_type: "upgrade", hospital_id: "h1", hospital_subscription_id: "s1", plan_id: 3,
+};
+const sub = { hospital_subscription_id: "s1", hospital_id: "h1", plan_id: 2, status: "Active" };
+
+test("a paid upgrade produces the same update as upgrade_subscription()", () => {
+  assert.deepEqual(planUpgrade(payment, sub, NOW), {
+    apply: true,
+    expectedPlanId: 2,
+    update: { previous_plan_id: 2, plan_id: 3, status: "Active", last_changed_at: NOW, updated_at: NOW },
+  });
+});
+
+test("end_date and billing fields are never touched", () => {
+  const decision = planUpgrade(payment, sub, NOW);
+  assert.ok(decision.apply);
+  for (const field of ["end_date", "start_date", "billing_cycle", "last_renewed_at"]) {
+    assert.ok(!(field in decision.update), field);
+  }
+});
+
+test("a repeated webhook is a no-op once applied", () => {
+  assert.deepEqual(planUpgrade(payment, { ...sub, plan_id: 3 }, NOW), { apply: false, reason: "already_applied" });
+});
+
+test("mismatches and missing data are refused", () => {
+  assert.equal((planUpgrade({ ...payment, payment_type: "renewal" }, sub, NOW) as { reason: string }).reason, "not_upgrade");
+  assert.equal((planUpgrade({ ...payment, plan_id: null }, sub, NOW) as { reason: string }).reason, "missing_fields");
+  assert.equal((planUpgrade(payment, null, NOW) as { reason: string }).reason, "subscription_not_found");
+  assert.equal((planUpgrade(payment, { ...sub, hospital_id: "h2" }, NOW) as { reason: string }).reason, "hospital_mismatch");
+  assert.equal((planUpgrade(payment, { ...sub, hospital_subscription_id: "s2" }, NOW) as { reason: string }).reason, "subscription_mismatch");
+  assert.equal((planUpgrade(payment, { ...sub, status: "Cancelled" }, NOW) as { reason: string }).reason, "subscription_cancelled");
+});
