# LungSightAI — Expo mobile app environment
# Copy to `mobile_app/.env` and fill in real values.
# EXPO_PUBLIC_* values are bundled into the app and are visible to anyone
# who installs it: only use the anon / publishable key here, NEVER the
# service-role / secret key. Data access is protected by Supabase RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key
