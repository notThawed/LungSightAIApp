# LungSightAI — Streamlit web app environment
# Copy to `.env` in the project root and fill in real values.
# Never commit `.env`. On Streamlit Cloud put the same keys in Secrets.

# Supabase project (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable / anon key
SUPABASE_KEY=your-anon-or-publishable-key
# Secret / service-role key — SERVER SIDE ONLY. Never put this in the mobile app.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Optional
# Where Supabase invite emails redirect (forwards tokens back to the app)
INVITE_REDIRECT_URL=https://notthawed.github.io/LungSightAuthRedirect/
# Public URL of this Streamlit app (used for PayMongo return URLs)
APP_BASE_URL=http://localhost:8501
# PayMongo secret key for subscription checkout
PAYMONGO_SECRET_KEY=
# CARTO basemap key for the geospatial map (falls back to free tiles if empty)
CARTO_API_KEY=
